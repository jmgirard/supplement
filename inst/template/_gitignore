# Fitted models and other saved R objects can embed the data. The bracket
# patterns match any mix of upper and lower case, as on Linux git is
# case-sensitive.
*.[Rr][Dd][Ss]
*.[Rr][Dd][Aa]
*.[Rr][Dd][Aa][Tt][Aa]
*.[Qq][Ss]
*.[Qq][Ss]2
analyses/fits/

# Files that reports write next to their sources. Save paper figures in
# figures/ instead.
analyses/*.html
analyses/*_files/
analyses/*.[Pp][Dd][Ff]
analyses/*.[Pp][Nn][Gg]

# Temporary files that save_png() in the example report leaves if R stops
# while it draws.
.save-*.png

# Private data. Keep it outside this folder, or put it here.
private/

# Published output. These lines undo rules elsewhere in this file (for
# example the `docs/` rule in GitHub's R template) that would keep the site
# out of git.
!docs/
!_freeze/
